# ======================= Gimble production settings =======================
# Copy to .env.production and fill in. NEVER commit the real file.

APP_ENV=production
DOMAIN=gimble.example.com                  # your domain (docker-compose.prod.yml / Caddy)
PUBLIC_URL=https://gimble.example.com      # used in email links - must be your real https address
TRUST_PROXY=true                           # you are behind Caddy / a platform load balancer

# ---- Secrets (generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))") ----
JWT_SECRET=
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=                            # 12+ characters; this creates your admin login on first start

# ---- Database: PostgreSQL (this is what makes data PERMANENT) ----
POSTGRES_PASSWORD=                         # docker-compose.prod.yml only
# On a platform (Render / Railway / Fly / Supabase / Neon...) set DATABASE_URL to the connection string they give you,
# e.g.  DATABASE_URL=postgres://user:password@host:5432/dbname   (postgres:// and postgresql:// both work)

# ---- Photo & document storage ----
# Option 1 (single server): keep STORAGE_BACKEND=local and the Docker volumes in docker-compose.prod.yml (already persistent).
# Option 2 (platforms / multiple servers): an S3-compatible bucket - AWS S3, Cloudflare R2, Backblaze B2, DigitalOcean Spaces...
STORAGE_BACKEND=local                      # local | s3
#S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com    # blank for AWS S3
#S3_REGION=auto                            # R2: auto   AWS: e.g. ap-south-1
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_PUBLIC_BUCKET=gimble-photos            # profile photos
#S3_PRIVATE_BUCKET=gimble-private          # ID documents. MUST be a different bucket and must NOT be public
#S3_PUBLIC_BASE_URL=https://photos.yourdomain.com   # optional CDN / public URL of the photos bucket (faster; recommended)

# ---- Email (needed for verification + password reset) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Gimble <no-reply@yourdomain.com>
REQUIRE_VERIFIED_EMAIL=true                # set false until SMTP works (the app refuses to start if true without SMTP_HOST)

# ---- Payments (Razorpay) - leave blank until you're ready; admins can grant memberships meanwhile ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Business rules ----
PLATFORM_FEE_PERCENT=15
MIN_PAYOUT_INR=500
PAYOUT_HOLD_HOURS=24
SUPPORT_EMAIL=support@yourdomain.com

# ---- Never change these in production ----
SEED_DEMO=false
DEMO_PAYMENTS_ENABLED=false

# Manual UPI QR payments (used when Razorpay keys are blank). Customers scan your QR, pay, upload proof; admins approve.
# Replace frontend/upi-qr.png with YOUR QR image. Leave UPI_ID blank to switch this off.
UPI_ID=yourname@okaxis
UPI_PAYEE_NAME=Gimble
UPI_QR_URL=/upi-qr.png
