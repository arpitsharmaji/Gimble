APP_ENV=development            # set to "production" to enforce safe settings (see README)
DATABASE_URL=sqlite:///./gimble.db
JWT_SECRET=replace-with-a-random-string-of-32-plus-characters
ADMIN_EMAIL=admin@gimble.local
ADMIN_PASSWORD=ChangeMe_Admin_123!
PUBLIC_URL=http://localhost:8000

# Dev conveniences (forced OFF/rejected in production)
SEED_DEMO=true
DEMO_PAYMENTS_ENABLED=true

# Razorpay (leave blank for demo mode). Use TEST keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (without SMTP_HOST, emails are printed to the server log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Gimble <no-reply@yourdomain.com>

# Money
PLATFORM_FEE_PERCENT=15       # Gimble's cut of each completed booking (proposed)
MIN_PAYOUT_INR=500
PAYOUT_HOLD_HOURS=24           # dispute window before earnings can be withdrawn
SUPPORT_EMAIL=support@yourdomain.com

REQUIRE_VERIFIED_EMAIL=false   # true in production
TRUST_PROXY=false              # true only behind your own reverse proxy
